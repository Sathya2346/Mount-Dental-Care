# Copy this file to backend/.env for local development, or paste the same keys
# into the host's environment-variable screen for a deployment.
# Local development works with DEBUG=True, SQLite and media inside backend/media.

# --- Core ---------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True

# Comma separated. On the host use the real domain(s), e.g.
#   ALLOWED_HOSTS=mount-dental-care.onrender.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Origin of the site allowed to call the API (scheme + host). Only needed when
# the React app is served from a different domain than the API — a
# single-service deploy serves both, so this can stay empty.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Required by Django for admin logins / POSTs behind the host's proxy:
#   CSRF_TRUSTED_ORIGINS=https://mount-dental-care.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------
# Leave empty for the local SQLite file. On the host, paste the Postgres
# connection string the platform provides:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
# true only when the database is reached over the public internet
# (e.g. Render "External Database URL") instead of a private network.
DB_SSL=false

# --- Uploaded files -----------------------------------------------------
# Folder holding logo, doctor, gallery, hero banner, award and video uploads.
# On the host point this at the mounted persistent disk, otherwise every
# deploy starts again without the images uploaded in Admin.
#   MEDIA_ROOT_DIR=/var/mount-dental-media
MEDIA_ROOT_DIR=

# --- First deploy -------------------------------------------------------
# The release step creates/repairs this admin account; it can also be run by
# hand with `python manage.py ensure_admin`.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# true = publish the bundled default content on deploy (runs seed_demo). It
# only fills missing/blank records, so Admin edits are kept.
SEED_ON_DEPLOY=true
# true = let the bundled content overwrite existing records (first deploy only).
SEED_RESET=false
# true = force the superuser password above on the next ensure_admin run.
ADMIN_RESET_PASSWORD=false

# --- Gmail (appointment OTP emails) -------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
# 16-character Google app password (not the normal Gmail password).
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=120
EMAIL_TIMEOUT=20

# --- HTTPS hardening (optional) ----------------------------------------
# Most hosts already redirect HTTP -> HTTPS. Enable these after the domain is
# live and HTTPS works, e.g. SECURE_SSL_REDIRECT=true and
# SECURE_HSTS_SECONDS=31536000 (one year). HSTS is hard to undo — read up
# before enabling it on a domain that is also used without HTTPS.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO

# --- MySQL database (recommended for local XAMPP and MySQL VPS) ---
USE_MYSQL=true
MYSQL_DATABASE=mount_dental_care
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
