# ============================================================================
#  PRODUCTION environment for https://www.mountdentalcare.com/
#  Host: Hostinger VPS (Ubuntu) — Django + gunicorn + nginx
# ============================================================================
#  On the server:
#      cd /var/www/mountdentalcare/backend
#      cp .env.production .env
#      nano .env        # replace every CHANGE_ME below
#
#  Django reads this file automatically (config/settings.py -> load_dotenv).
#  No secret values are stored in this file on purpose.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DEBUG=False

# The site must only answer for its own domain(s).
ALLOWED_HOSTS=mountdentalcare.com,www.mountdentalcare.com,127.0.0.1,localhost

# Required by Django for Admin logins and every POST behind nginx's proxy.
CSRF_TRUSTED_ORIGINS=https://mountdentalcare.com,https://www.mountdentalcare.com

# Leave empty: nginx and Django serve the site from one origin, so the React
# app calls /api on the same domain and no CORS entry is needed.
CORS_ALLOWED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Empty = SQLite file at backend/db.sqlite3. Fine for a low-traffic clinic
# site. For heavier traffic install PostgreSQL and use, e.g.:
#   DATABASE_URL=postgres://mdc:password@127.0.0.1:5432/mountdentalcare
DATABASE_URL=
DB_SSL=false

# --- Uploaded files ---------------------------------------------------------
# Logo, doctor photos, gallery, hero banners and videos uploaded in Admin.
# Keep this OUTSIDE the code folder so a re-deploy never deletes them.
MEDIA_ROOT_DIR=/var/www/mountdentalcare/backend/media

# --- Django Admin account (created by `manage.py ensure_admin`) -------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=CHANGE_ME_admin@mountdentalcare.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_strong_admin_password
# Set true only if you need to force this password over an existing account.
ADMIN_RESET_PASSWORD=false

# Publish the bundled default content on deploy. Safe and idempotent: it only
# fills blank/missing records, so your Admin edits are always preserved.
SEED_ON_DEPLOY=true
# true = let the bundled content overwrite existing records (first deploy only).
SEED_RESET=false

# --- Gmail (appointment OTP emails) ----------------------------------------
# EMAIL_HOST_PASSWORD MUST be a 16-character Google "App Password",
# not your normal Gmail password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME_your_gmail@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_16_char_google_app_password
DEFAULT_FROM_EMAIL=CHANGE_ME_your_gmail@gmail.com

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=120
EMAIL_TIMEOUT=20

# --- HTTPS hardening --------------------------------------------------------
# certbot already redirects HTTP -> HTTPS at nginx, so these can stay off.
# After HTTPS is confirmed working you may set SECURE_SSL_REDIRECT=true.
SECURE_SSL_REDIRECT=false
# HSTS is hard to undo — only enable after the domain is fully settled.
SECURE_HSTS_SECONDS=0

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
